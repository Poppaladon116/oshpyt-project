+test("global number variable", () => {
+  const program = parse(`
+    Create count as Number
+    Set count to 42
+    Call Print(count)
+  `);
+
+  interpreter.register(program);
+  interpreter.executeTopLevelCalls(program);
+
+  expect(logSpy).toHaveBeenCalledWith(42);
+});
+
+test("local function variable", () => {
+  const program = parse(`
+    Define Test() {
+      Create localVal as String
+      Set localVal to "inside function"
+      Call Print(localVal)
+    }
+
+    Call Test()
+  `);
+
+  interpreter.register(program);
+  interpreter.executeTopLevelCalls(program);
+
+  expect(logSpy).toHaveBeenCalledWith("inside function");
+});
+
+test("local variable shadowing", () => {
+  const program = parse(`
+    Create message as String
+    Set message to "global"
+
+    Define Shadow() {
+      Create message as String
+      Set message to "local"
+      Call Print(message)
+    }
+
+    Call Shadow()
+    Call Print(message)
+  `);
+
+  interpreter.register(program);
+  interpreter.executeTopLevelCalls(program);
+
+  expect(logSpy).toHaveBeenNthCalledWith(1, "local");
+  expect(logSpy).toHaveBeenNthCalledWith(2, "global");
+});
+
